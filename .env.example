# 백엔드가 준비되기 전까지는 MSW(Mock Service Worker)로 /api 요청을 인메모리에서 처리.
# 진짜 백엔드 붙이면 VITE_USE_MOCKS=false 로 끄면 됨.
# Vercel에서도 같은 변수명으로 끄거나 켤 수 있다.
VITE_USE_MOCKS=true

# 같은 origin 기준 상대 경로. 다른 도메인의 백엔드면 절대 URL로 덮어씀 (반드시 `/api` 까지 포함).
# 로컬 개발: vite proxy 가 /api → localhost:8080 이므로 기본 `/api` 로 충분할 수 있음.
VITE_API_BASE_URL=/api

# --- Railway 프로덕션 (CUU-BACK-Spring) 예시 ---
# 복사해서 .env 또는 .env.local 에 붙이고, MSW 를 끈 뒤 사용.
# VITE_USE_MOCKS=false
# VITE_API_BASE_URL=https://cuu-back-spring-production.up.railway.app/api

# 프로필 화면에서 역할 전환(백엔드 PATCH /users/me/role/...) — 운영에서는 끄거나 슈퍼관리만 쓰도록 권장
# VITE_ENABLE_ROLE_SWITCH=true

# Firebase Auth (P1 — 미설정 시 mock 로그인 사용)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
